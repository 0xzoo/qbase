# Qbase — local development environment variables
#
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored and must never be committed. In production every one
# of these is bound with `wrangler secret put`; `wrangler.jsonc` carries bindings
# and non-secret vars only. Values below are placeholders — replace them all.

# --- Network ---------------------------------------------------------------
NETWORK_ID="base-sepolia"

# --- Chain / RPC -----------------------------------------------------------
BASE_RPC_URL="https://mainnet.base.org"
ALCHEMY_API_KEY="YOUR_ALCHEMY_KEY"
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_KEY"

# --- Quilibrium QStorage (S3-compatible) -----------------------------------
QSTORAGE_ENDPOINT="https://qstorage.quilibrium.com"
QSTORAGE_BUCKET="qbase"
QSTORAGE_REGION="q-world-1"
QSTORAGE_ACCESS_KEY="YOUR_QSTORAGE_ACCESS_KEY"
QSTORAGE_SECRET_KEY="YOUR_QSTORAGE_SECRET_KEY"
QUILIBRIUM_ACCOUNT_ID="YOUR_QUILIBRIUM_ACCOUNT_ID"

# --- Answer sealing (Secret / Allowlist tiers) -----------------------------
# Key-encryption keys for SecretBox. Accepts a JSON map
#   {"current":"k1","keys":{"k1":"<base64 32 bytes>"}}
# or a bare base64 string read as a single key (k1). The JSON shape is required
# from the first rotation onward, because a bare string holds only one key.
ANSWER_KEKS="YOUR_BASE64_32_BYTE_KEY"

# --- Anon tier (sealed to Q) ------------------------------------------------
# HMAC key behind anon_attributions.author_tag: 32 random bytes, base64.
#   openssl rand -base64 32
# Rotating it means recomputing every tag from author_ct (admin sweep); it is
# not a KEK and is not part of ANSWER_KEKS rotation.
ANON_TAG_KEY="YOUR_BASE64_32_BYTE_KEY"

# --- Farcaster / Neynar ----------------------------------------------------
NEYNAR_API_KEY="YOUR_NEYNAR_API_KEY"
NEYNAR_CLIENT_ID="YOUR_NEYNAR_CLIENT_ID"
NEYNAR_SECRET="YOUR_NEYNAR_SECRET"
NEYNAR_MANAGER_SIGNER="YOUR_NEYNAR_SIGNER_UUID"
NEYNAR_ANON_BOT_API_KEY="YOUR_ANON_BOT_NEYNAR_KEY"
NEYNAR_ANON_BOT_SIGNER_UUID="YOUR_ANON_BOT_SIGNER_UUID"
QGENT_NEYNAR_API_KEY="YOUR_AGENT_NEYNAR_KEY"
QGENT_SIGNER_UUID="YOUR_AGENT_SIGNER_UUID"
SPONSOR_SIGNER="YOUR_SPONSOR_SIGNER_UUID"

# --- Farcaster signers (self-managed Ed25519) ------------------------------
# Registered directly against each account's custody wallet on Optimism's
# KeyGateway, one per bot account. scripts/register-anon-signer.ts does this.
ANON_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"
QGENT_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"
QLAUDE_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"
QEMINI_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"
CHATQPT_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"
POLLS_SIGNER_KEY="0xYOUR_ED25519_PRIVATE_KEY"

# --- Webhook HMAC secrets --------------------------------------------------
HYPERSNAP_WEBHOOK_SECRET="YOUR_HMAC_SECRET"
QGENT_WEBHOOK_SECRET="YOUR_HMAC_SECRET"

# --- Admin -----------------------------------------------------------------
QBASE_ADMIN_SECRET="YOUR_RANDOM_ADMIN_SECRET"
QGENT_ADMIN_SECRET="YOUR_RANDOM_ADMIN_SECRET"
QBASE_SECRET="YOUR_RANDOM_SECRET_STRING"

# --- Oracle escrow (Base) --------------------------------------------------
ORACLE_AGENT_KEY="0xYOUR_ESCROW_AGENT_PRIVATE_KEY"
QBASE_TREASURY_ADDRESS="0xYOUR_TREASURY_ADDRESS"
BARTLET_TREASURY_KEY="0xYOUR_TREASURY_PRIVATE_KEY"

# --- World ID for Agents (IdP device grant) -------------------------------
# Off unless AGENT_APPROVAL_ENABLED="1" (a var, set on staging only). The
# client is confidential (client_secret_basic); the secret stays in the worker.
AGENT_APPROVAL_ENABLED="0"
WORLD_IDP_ISSUER="https://sandbox.auth.world.org"
WORLD_IDP_CLIENT_ID="YOUR_IDP_CLIENT_ID"
WORLD_IDP_CLIENT_SECRET="YOUR_IDP_CLIENT_SECRET"
# Agent bearer keys, JSON {"agent_id": "key"}; keys shorter than 16 chars are ignored.
AGENT_API_KEYS='{"qgent":"YOUR_LONG_RANDOM_KEY"}'

# --- AI providers ----------------------------------------------------------
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY"
OPENAI_API_KEY="YOUR_OPENAI_KEY"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_KEY"
GOOGLE_API_KEY="YOUR_GOOGLE_KEY"

# --- Cloudflare ------------------------------------------------------------
# D1 / KV / R2 / Vectorize / Durable Object / AI bindings are declared in
# wrangler.jsonc; these are for scripts that call the Cloudflare API directly.
CLOUDFLARE_ACCOUNT_ID="YOUR_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="YOUR_API_TOKEN"
R2_API_KEY="YOUR_R2_KEY"
WORKERS_AI_API_KEY="YOUR_WORKERS_AI_KEY"

# --- Coinbase Developer Platform -------------------------------------------
CDP_API_KEY_NAME="organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID"
CDP_API_KEY_PRIVATE_KEY="YOUR_EC_PRIVATE_KEY_IN_PEM_FORM"

# --- Misc ------------------------------------------------------------------
QUOTIENT_API_KEY="YOUR_QUOTIENT_KEY"
