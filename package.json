{
  "name": "qbase",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "tsc -b && vite build",
    "rebuild": "yarn clean && yarn build",
    "lint": "eslint .",
    "preview": "yarn run build && vite preview",
    "deploy": "yarn run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "validate": "yarn lint && yarn build",
    "migrate:dev": "wrangler d1 migrations apply dev-qbase --config wrangler.dev.jsonc --remote",
    "migrate:prod": "wrangler d1 migrations apply prod-qbase --config wrangler.jsonc --remote",
    "backup:dev": "mkdir -p backups && wrangler d1 export dev-qbase --output backups/dev-$(date +%Y%m%d-%H%M%S).sql --config wrangler.dev.jsonc",
    "backup:prod": "mkdir -p backups && wrangler d1 export prod-qbase --output backups/prod-$(date +%Y%m%d-%H%M%S).sql --config wrangler.jsonc",
    "deploy:dev": "yarn build && npx wrangler deploy --config wrangler.dev.jsonc",
    "deploy:prod": "yarn build && npx wrangler deploy --config wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.3",
    "@chenglou/pretext": "^0.0.1",
    "@farcaster/auth-client": "^0.7.0",
    "@farcaster/auth-kit": "^0.8.1",
    "@farcaster/frame-sdk": "^0.1.12",
    "@farcaster/hub-nodejs": "^0.15.9",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@farcaster/miniapp-wagmi-connector": "^1.1.0",
    "@farcaster/quick-auth": "^0.0.8",
    "@farcaster/snap": "^2.2.0",
    "@flaunch/sdk": "^0.9.9",
    "@neynar/nodejs-sdk": "^3.97.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/node": "^25.0.3",
    "@types/three": "^0.184.1",
    "@worldcoin/idkit": "4.3.0",
    "@worldcoin/idkit-core": "4.3.0",
    "framer-motion": "^12.23.26",
    "gsap": "^3.15.0",
    "lucide-react": "^0.554.0",
    "multiformats": "^13.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.9.6",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.5.0",
    "three": "^0.184.0",
    "viem": "^2.40.2",
    "vite-plugin-node-polyfills": "^0.24.0",
    "wagmi": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.17.1",
    "@cloudflare/vitest-pool-workers": "^0.14.1",
    "@eslint/js": "^9.33.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-is": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
