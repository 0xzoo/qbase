/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qbase",
	"main": "worker/index.ts",
	"compatibility_date": "2025-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Vectorize binding for the q-index
	"vectorize": [
		{
			"binding": "QINDEX",
			"index_name": "q-index"
		},
		{
			"binding": "AINDEX",
			"index_name": "a-index"
		}
	],
	// D1 database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prod-qbase",
			"database_id": "a2dbf8c2-9dca-445b-be5c-1f6ba459abf3",
			"preview_database_id": "DB"
		}
	],
	// KV namespace binding for frame notifications
	"kv_namespaces": [
		{
			"binding": "KV_FRAME_NOTIFICATIONS",
			"id": "8e1e2a589b3342439a0b0e706683b7dc"
		},
		{
			"binding": "KV_USER_PROFILES",
			"id": "7a43aee9a5274cb883b17a17b9ded46b"
		},
		{
			"binding": "KV_USER_POINTS",
			"id": "5c815e8e9c2b49fca0403be9a699cbae"
		},
		{
			"binding": "BARTLET_SESSIONS",
			"id": "d404f39d2d5e487397e18cb5f226b1c6",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "qbase-images"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "QGENT",
				"class_name": "QAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"QAgent"
			]
		}
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	"vars": {
		"QGENT_FID": "975961",
		"QBASE_FID": "272012",
		"SPONSOR_SIGNER": "true",
		"QSTORAGE_ENDPOINT": "https://qstorage.quilibrium.com",
		"QSTORAGE_BUCKET": "qbase",
		"QSTORAGE_REGION": "q-world-1",
		"QQ_CONTRACT_ADDRESS": "0x7d39833d9d5baa835ba19e964e4ba114521ccfe4",
		"HOSTNAME": "qbase.tech",
		"BARTLET_AIRDROP_ENABLED": "1",
		"BASE_RPC_URL": "https://base.llamarpc.com",
		"BARTLET_TREASURY_ADDRESS": "0x278603E93fE7B1517FD69eFA65BABda33beFbEe1"
	},
	/**
	 * Cron Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 * Runs daily at midnight UTC to update topic metrics and relations
	 */
	"triggers": {
		"crons": [
			"0 0 * * *",
			"0 8 * * *",
			"0 16 * * *"
		]
	}
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}