/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qbase",
	"main": "worker/index.ts",
	"compatibility_date": "2025-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Vectorize binding for the q-index
	"vectorize": [
		{
			"binding": "QINDEX",
			"index_name": "q-index"
		},
		{
			"binding": "AINDEX",
			"index_name": "a-index"
		}
	],
	// D1 database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prod-qbase",
			"database_id": "a2dbf8c2-9dca-445b-be5c-1f6ba459abf3",
			"preview_database_id": "DB"
		}
	],
	// KV namespace binding for frame notifications
	"kv_namespaces": [
		{
			"binding": "KV_FRAME_NOTIFICATIONS",
			"id": "8e1e2a589b3342439a0b0e706683b7dc"
		},
		{
			"binding": "KV_USER_PROFILES",
			"id": "7a43aee9a5274cb883b17a17b9ded46b"
		},
		{
			"binding": "KV_USER_POINTS",
			"id": "5c815e8e9c2b49fca0403be9a699cbae"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "qbase-images"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "QGENT",
				"class_name": "Q",
				"script_name": "q"
			}
		]
	},
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	"vars": {
		"QGENT_FID": "975961",
		"QBASE_FID": "272012",
		"SPONSOR_SIGNER": "true",
		"NILAUTH_URL": "https://nilauth.sandbox.app-cluster.sandbox.nilogy.xyz",
		"NILLION_PUBLIC_KEY": "03da251dc84461445d66300bc8cbf2ffacd2c0aa2ccaf8720ddec2f38ebf4b5a13",
		"NILLION_PROXY_URL": "https://qbase-nillion-proxy.fly.dev",
		"NILLION_PRIVATE_ANSWER_SCHEMA_ID": "e40e57e4-fd34-4ed0-9f30-5c8a55a96e83",
		"NILLION_ALLOWLIST_ANSWER_SCHEMA_ID": "1acc884b-f578-4e8c-b8d1-97d3771d038b",
		"NILLION_ANON_ANSWER_SCHEMA_ID": "269ac9c5-ca2d-4391-a98b-3e6ac6bdd7aa",
		"NILLION_ANON_QUERY_ATTRIBUTION_SCHEMA_ID": "f717cddb-b8ea-4192-8f32-c7fb0f9c5eac",
		"QQ_CONTRACT_ADDRESS": "0x7d39833d9d5baa835ba19e964e4ba114521ccfe4",
		"HOSTNAME": "qbase.tech"
	},
	/**
	 * Cron Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 * Runs daily at midnight UTC to update topic metrics and relations
	 */
	"triggers": {
		"crons": ["0 0 * * *"]
	}
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}