/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qbase",
	"main": "worker/index.ts",
	"compatibility_date": "2025-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Vectorize binding for the q-index
	"vectorize": [
		{
			"binding": "QINDEX",
			"index_name": "q-index"
		},
		{
			"binding": "AINDEX",
			"index_name": "a-index"
		}
	],
	// D1 database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prod-qbase",
			"database_id": "a2dbf8c2-9dca-445b-be5c-1f6ba459abf3",
			"preview_database_id": "DB"
		}
	],
	// KV namespace binding for frame notifications
	"kv_namespaces": [
		{
			"binding": "KV_FRAME_NOTIFICATIONS",
			"id": "8e1e2a589b3342439a0b0e706683b7dc"
		},
		{
			"binding": "KV_USER_PROFILES",
			"id": "7a43aee9a5274cb883b17a17b9ded46b"
		},
		{
			"binding": "KV_USER_POINTS",
			"id": "5c815e8e9c2b49fca0403be9a699cbae"
		},
		{
			"binding": "BARTLET_SESSIONS",
			"id": "d404f39d2d5e487397e18cb5f226b1c6",
			"remote": true
		},
		{
			"binding": "VALUES_SESSIONS",
			"id": "ef698c14096c41838bd5c3e19a0229e2",
			"remote": true
		},
		{
			"binding": "APPERCEPTION_SESSIONS",
			"id": "3aedb25ce7e04bde99420665da26ab62",
			"remote": true
		},
		{
			"binding": "CA_SLATE_SESSIONS",
			"id": "fa05647bbb384a53ba4f9707ab2173bb",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "qbase-images"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "QGENT",
				"class_name": "QAgent"
			},
			{
				"name": "RATE_LIMIT",
				"class_name": "RateLimitDO"
			},
			{
				"name": "ORACLE",
				"class_name": "OracleAgent"
			}
		]
	},
	// Cloudflare Queues — answer-cast posting.
	// The Worker produces onto ANSWER_CAST_QUEUE when a public answer is
	// submitted; the queue consumer in worker/index.ts drains it and calls
	// Hypersnap. Keeps user-facing latency decoupled from Hypersnap
	// throughput. See docs/hypersnap/data-layer.md § Write-path queueing.
	"queues": {
		"producers": [
			{
				"binding": "ANSWER_CAST_QUEUE",
				"queue": "qbase-answer-casts"
			}
		],
		"consumers": [
			{
				"queue": "qbase-answer-casts",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "qbase-answer-casts-dlq"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"QAgent"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"RateLimitDO"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"OracleAgent"
			]
		},
		{
			// OracleAgent is WIP and lives outside the committed tree; its
			// import was stripped from worker/index.ts so the git build can
			// resolve. Migration history is append-only, so we keep v3 and tear
			// the class down with deleted_classes rather than dropping the
			// create migration. Safe whether or not v3 was ever applied.
			"tag": "v4",
			"deleted_classes": [
				"OracleAgent"
			]
		},
		{
			// OracleAgent now ships (cast-mention oracle: @qlaude/@chatqpt/@qemini).
			// Re-create the SQLite-backed DO class that v4 deleted.
			"tag": "v5",
			"new_sqlite_classes": [
				"OracleAgent"
			]
		}
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	"vars": {
		"QGENT_FID": "975961",
		"QBASE_FID": "272012",
		"SPONSOR_SIGNER": "true",
		"QSTORAGE_ENDPOINT": "https://qstorage.quilibrium.com",
		"QSTORAGE_BUCKET": "qbase",
		"QSTORAGE_REGION": "q-world-1",
		"QQ_CONTRACT_ADDRESS": "0x7d39833d9d5baa835ba19e964e4ba114521ccfe4",
		"HOSTNAME": "qbase.tech",
		"BARTLET_AIRDROP_ENABLED": "1",
		"VALUES_AIRDROP_ENABLED": "1",
		"APPERCEPTION_AIRDROP_ENABLED": "1",
		"BASE_RPC_URL": "https://base.llamarpc.com",
		"QBASE_GATE_ADDRESS": "0x3fA4CC86B79d22Db14d0f3F9031F1a6F198b8DEC",
		"AIRDROP_VAULT_ADDRESS": "0x6a7E477D15ee349c7bBB5c57d28f583B5cC5BFba",
		// Paid council (docs/specs/paid-council.md): whole $QQ per summon; "0" = free (gate off).
		// With a price set and no ORACLE_ESCROW_ADDRESS the council refuses (escrow_unconfigured).
		"COUNCIL_PRICE_QQ": "0",
		// Set after OracleEscrow deploy — see contracts/script/Deploy.s.sol
		// "ORACLE_ESCROW_ADDRESS": "...",
		"ANON_FID": "514282",
		"POLLS_FID": "3321680",
		// Oracle council accounts (Track C card C5: each casts as itself via the hub).
		"QLAUDE_FID": "1729350",
		"QEMINI_FID": "1729476",
		"CHATQPT_FID": "1729438",
		"HYPERSNAP_ENDPOINT": "https://haatz.quilibrium.com",
		"HUB_ENDPOINT": "https://haatz.quilibrium.com",
		"QBASE_EMBED_HOST": "qbase.tech",
		// Feature flag: set to "true" to read from question_meta/answer_meta/cast_stats_cache
		// instead of the legacy queries/Answers tables. Default "false" (old path).
		"HYPERSNAP_READ_PATH": "false"
	},
	// Secrets are set with `wrangler secret put` and are never inlined in this
	// file. For local development they go in the gitignored `.dev.vars` — see
	// .dev.vars.example for a starting template.
	/**
	 * Cron Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
 *   slash-2 (every 2 min) → Hypersnap reconciler (Phase 2)
 *   0 * * * * (hourly) → orphan sweep (alert on stale unreconciled rows)
 *   0 0/8 * * * (3x/day) → topic metrics + Q agent analysis
 *   0 0 * * 0 (weekly Sun) → oracle settlement
	 */
	"triggers": {
		"crons": [
			// "*/2 * * * *",   // Hypersnap reconciler — paused (no users yet)
			"0 * * * *",
			"0 0/8 * * *"
			]
	}
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}