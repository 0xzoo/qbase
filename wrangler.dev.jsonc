{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qbase-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-10",
  "compatibility_flags": ["nodejs_compat"],
  
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  
  "observability": {
    "enabled": true
  },
  
  "vars": {
    "QGENT_FID": "975961",
    "QBASE_FID": "272012",
    "SPONSOR_SIGNER": "true",
    "NILAUTH_URL": "https://nilauth.sandbox.app-cluster.sandbox.nilogy.xyz",
    "NILLION_PUBLIC_KEY": "03da251dc84461445d66300bc8cbf2ffacd2c0aa2ccaf8720ddec2f38ebf4b5a13",
		"NILLION_PRIVATE_ANSWER_SCHEMA_ID": "a98998ee-865f-4acb-875c-b5ba017ef885",
    "NILLION_ANON_ANSWER_SCHEMA_ID": "2bbfa785-833d-44dc-bd60-5ed629549257",
    "NILLION_ALLOWLIST_ANSWER_SCHEMA_ID": "3cf4da61-17cc-43fb-9f83-6005dcd2a831",
    "NILLION_ANON_QUERY_ATTRIBUTION_SCHEMA_ID": "112be88b-6d0e-49c5-a969-e2b6ebc40193",
    "QQ_CONTRACT_ADDRESS": "0x7d39833d9d5baa835ba19e964e4ba114521ccfe4",
    "HOSTNAME": "qbase-dev.z00.workers.dev"
  },
  
  "vectorize": [
    { "binding": "QINDEX", "index_name": "q-index-dev" },
    { "binding": "AINDEX", "index_name": "a-index-dev" }
  ],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-qbase",
      "database_id": "0f896176-7744-4b1b-b4c2-69c78e796192"
    }
  ],
  
  "kv_namespaces": [
    {
      "binding": "KV_FRAME_NOTIFICATIONS",
      "id": "d5d3bdc9c30b42888d094ff7292c7f95"
    },
    {
      "binding": "KV_USER_PROFILES",
      "id": "ac7a41cef8ee4b529c93236755814976"
    },
    { 
      "binding": "KV_USER_POINTS",
      "id": "df6b0ee350574fd6b63738840579ddc3" 
    }
  ],
  
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "qbase-images-dev" }
  ],
  
  "ai": { "binding": "AI" },
  
  "durable_objects": {
    "bindings": [
      {
        "name": "QGENT",
        "class_name": "Q",
        "script_name": "q"
      }
    ]
  },
  
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ]
}