{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnonAnswer",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "_id": {
        "type": "string",
        "format": "uuid",
        "coerce": true
      },
      "q_id": {
        "type": "string"
      },
      "user_id": {
        "type": "object",
        "properties": {
          "%share": {
            "type": "string",
            "description": "Encrypted share of user ID"
          }
        },
        "required": [
          "%share"
        ]
      },
      "value": {
        "type": "string",
        "description": "Plain text answer"
      },
      "answer_type_id": {
        "type": "string"
      },
      "suggested_answer_type_id": {
        "type": "string"
      },
      "audience": {
        "type": "string",
        "enum": [
          "Anon"
        ]
      },
      "edited": {
        "type": "boolean"
      },
      "q_index": {
        "type": "integer"
      },
      "asset": {
        "type": "string"
      },
      "casthash": {
        "type": "string"
      },
      "parent_casthash": {
        "type": "string"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false,
    "required": [
      "_id",
      "q_id",
      "user_id",
      "value",
      "answer_type_id",
      "suggested_answer_type_id",
      "audience",
      "created_at"
    ]
  }
}