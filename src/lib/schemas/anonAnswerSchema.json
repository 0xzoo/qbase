{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnonAnswer",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "_id": {
        "type": "string",
        "format": "uuid",
        "coerce": true
      },
      "q_id": {
        "type": "string"
      },
      "user_id": {
        "type": "object",
        "properties": {
          "%share": {
            "type": "string",
            "description": "Encrypted share of user ID"
          }
        },
        "required": [
          "%share"
        ]
      },
      "value": {
        "type": "string",
        "description": "Plain text answer"
      },
      "answer_type_id": {
        "type": "string"
      },
      "suggested_answer_type_id": {
        "type": "string"
      },
      "audience": {
        "type": "string",
        "enum": [
          "Anon"
        ]
      },
      "edited": {
        "type": "boolean"
      },
      "q_index": {
        "type": "integer"
      },
      "asset": {
        "type": "string"
      },
      "casthash": {
        "type": "string"
      },
      "parent_casthash": {
        "type": "string"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "answer_storage_type": {
        "type": "string",
        "enum": ["identity", "temporal"],
        "description": "Whether this is an identity answer (one per user) or temporal answer (time-series)"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "description": "For identity answers: timestamp of last edit"
      },
      "is_deleted": {
        "type": "boolean",
        "description": "For temporal answers: soft delete flag (preserves research integrity)"
      }
    },
    "additionalProperties": false,
    "required": [
      "_id",
      "q_id",
      "user_id",
      "value",
      "answer_type_id",
      "suggested_answer_type_id",
      "audience",
      "created_at",
      "answer_storage_type"
    ]
  }
}