{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Answer",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "_id": {
        "type": "string",
        "format": "uuid",
        "coerce": true
      },
      "q_id": {
        "type": "string"
      },
      "user_id": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "object",
            "properties": {
              "%share": {
                "type": "string",
                "description": "An encrypted share of the ID of the user who provided the answer"
              }
            },
            "required": [
              "%share"
            ]
          }
        ]
      },
      "value": {
        "oneOf": [
          {
            "type": "string",
            "description": "JSON string containing structured answer data based on answer_type_id"
          },
          {
            "type": "object",
            "properties": {
              "%share": {
                "type": "string",
                "description": "An encrypted share of the answer"
              }
            },
            "required": [
              "%share"
            ]
          }
        ]
      },
      "edited": {
        "type": "boolean"
      },
      "asset": {
        "type": "string"
      },
      "casthash": {
        "type": "string"
      },
      "parent_casthash": {
        "type": "string"
      },
      "answer_type_id": {
        "type": "integer",
        "description": "FK to answer_types table: 1=text, 2=mc, 3=scale, 4=checkbox"
      },
      "suggested_answer_type_id": {
        "type": "integer",
        "description": "FK to answer_types table: 1=text, 2=mc, 3=scale, 4=checkbox"
      },
      "allowlist": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "audience": {
        "type": "string",
        "enum": [
          "Private",
          "Allowlist",
          "Public",
          "Anon"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "_id",
      "q_id",
      "user_id",
      "value",
      "answer_type_id",
      "suggested_answer_type_id",
      "audience"
    ]
  }
}
